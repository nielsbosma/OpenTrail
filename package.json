{
  "name": "opentrail",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.7.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"cargo run --bin opentrail\" \"pnpm --filter @opentrail/web dev\"",
    "build": "pnpm --filter @opentrail/web build && cargo build --release --bin opentrail",
    "typecheck": "pnpm --filter @opentrail/web typecheck",
    "lint": "biome check . && cargo clippy --workspace --all-targets -- -D warnings",
    "lint:fix": "biome check --write . && cargo fmt --all",
    "test": "cargo test --workspace && pnpm --filter @opentrail/web test",
    "api:types": "pnpm --filter @opentrail/web api:types",
    "infra:up": "docker compose up -d --wait postgres mailpit",
    "infra:down": "docker compose down",
    "stack:up": "docker compose --profile prod up -d --build --wait",
    "stack:fresh": "docker compose --profile prod down -v && docker compose --profile prod up -d --build --wait"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/node": "^24.19.2",
    "concurrently": "^10.0.7",
    "typescript": "^7.0.2"
  }
}
